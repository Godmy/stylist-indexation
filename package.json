{
  "name": "stylist-indexation",
  "version": "1.0.0",
  "type": "module",
  "description": "Barrel generator and export/dependency indexer for TypeScript and Svelte",
  "license": "MIT",
  "author": "Godmy",
  "homepage": "https://github.com/Godmy/stylist-indexation#readme",
  "bugs": {
    "url": "https://github.com/Godmy/stylist-indexation/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Godmy/stylist-indexation.git"
  },
  "keywords": [
    "typescript",
    "svelte",
    "sveltekit",
    "barrel",
    "index",
    "codegen",
    "exports",
    "dependency-graph"
  ],
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "stylist-indexation": "bin/stylist-indexation.js"
  },
  "exports": {
    ".": {
      "types": "./dist/class/facade/indexation-cli/index.d.ts",
      "default": "./dist/class/facade/indexation-cli/index.js"
    },
    "./package.json": "./package.json",
    "./*": {
      "types": "./dist/*/index.d.ts",
      "default": "./dist/*/index.js"
    }
  },
  "files": [
    "bin",
    "dist",
    "src/lib/indexation",
    "!src/lib/indexation/test",
    "CHANGELOG.md"
  ],
  "scripts": {
    "indexation": "node scripts/indexation.mjs",
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "check": "tsc --noEmit",
    "test": "vitest run --pool=threads",
    "prepack": "npm run build",
    "prepublishOnly": "npm run check && npm test",
    "format": "prettier --write src scripts bin package.json tsconfig.json tsconfig.build.json AGENTS.md README.md CHANGELOG.md RELEASING.md .github .prettierrc.json",
    "format:check": "prettier --check src scripts bin package.json tsconfig.json tsconfig.build.json AGENTS.md README.md CHANGELOG.md RELEASING.md .github .prettierrc.json"
  },
  "dependencies": {
    "typescript": "^5.9.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "prettier": "^3.9.10",
    "vitest": "^5.0.3"
  }
}
